# Copy to .env.local for `npm run dev`. On GitHub, add the same names as
# repository variables (Settings → Secrets and variables → Actions → Variables).
# Firebase console → Project settings → General → Your apps → Web app → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional: Google Drive in the Evidence Vault and Resource Library.
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web client.
VITE_GOOGLE_CLIENT_ID=
